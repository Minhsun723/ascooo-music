<?xml version="1.0" encoding="utf-8"?>
<!-- The session token is encrypted with a key that never leaves this device's keystore,
     so a restored copy could not be read anyway; keep it out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
