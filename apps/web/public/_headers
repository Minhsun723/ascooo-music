# Static assets only; /api responses get their headers from the Worker.
# Scripts and styles load only from this site, plus Google Fonts and the
# Cloudflare Web Analytics beacon that Cloudflare injects into the page.
# Artist motion artwork streams from Apple's video CDN: Safari plays the HLS
# playlist itself (media-src), other browsers fetch it through hls.js
# (connect-src) and play it from a MediaSource blob.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; media-src 'self' blob: https://mvod.itunes.apple.com; connect-src 'self' https://cloudflareinsights.com https://mvod.itunes.apple.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
