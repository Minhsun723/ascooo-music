{
  "name": "ascooo-music",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "dev:api": "npm run build && npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web",
    "dev:integrated": "npm run build && wrangler dev --port 8787",
    "build": "npm run build -w apps/web",
    "db:migrate:local": "wrangler d1 migrations apply ascooo-music --local",
    "db:migrate:remote": "wrangler d1 migrations apply ascooo-music --remote",
    "sync:local": "node scripts/run-local-sync.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run typecheck -w apps/worker && npm run typecheck -w apps/web"
  }
}
