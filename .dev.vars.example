# Paste the exact unified endpoint shown by PikPak for Client-1.
WEBDAV_URL=https://your-account-specific-webdav-endpoint.example
MUSIC_ROOT=/Music
# Flat folder of AAC 5.1 copies named exactly like their Dolby Atmos originals.
AAC51_ROOT=/ascooo-music/Music-Transcode/aac51

# PikPak-generated WebDAV credentials (not the normal account password).
WEBDAV_USERNAME=generated-client-username
WEBDAV_PASSWORD=generated-client-password

# Optional. In auto mode the Worker tries Basic first, then Bearer after a 401.
WEBDAV_BEARER_TOKEN=generated-bearer-token
WEBDAV_AUTH_MODE=auto

# Used only by Ascooo Music login sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Local-first sync uploads prepared metadata to this deployed site.
SYNC_TARGET_URL=https://music.ascooo.com
SYNC_ADMIN_USERNAME=your-admin-username
SYNC_ADMIN_PASSWORD=your-admin-password
# Used only by `npm run sync:dev`, which uploads to the local `wrangler dev`
# server. Each value falls back to its SYNC_* counterpart when left empty.
DEV_SYNC_TARGET_URL=http://127.0.0.1:8787
DEV_SYNC_ADMIN_USERNAME=
DEV_SYNC_ADMIN_PASSWORD=
# Local WebDAV metadata parsing concurrency (1-8).
SYNC_PARSE_CONCURRENCY=1

# Optional Apple Music enrichment, executed only by the local sync command.
# The public developer token is discovered automatically; paste one here only
# if automatic discovery stops working.
APPLE_MUSIC_ENABLED=true
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_USER_TOKEN=
APPLE_MUSIC_STOREFRONT=jp
APPLE_MUSIC_LYRICS_STOREFRONT=tw
APPLE_MUSIC_LANGUAGE=ja-JP
APPLE_MUSIC_LYRICS_PATH=/ascooo-music/lyrics
APPLE_MUSIC_REFRESH_DAYS=90
